{
  "name": "vellum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vellum — an offline-first study workspace for Markdown notes and CSV flashcards with spaced repetition.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
