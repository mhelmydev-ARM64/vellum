    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "framer-motion": "^14.1.0",
    "highlight.js": "^11.12.0",
    "localforage": "^1.10.0",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "papaparse": "^5.7.0",
